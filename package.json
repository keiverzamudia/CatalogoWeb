{
  "name": "catalogo-qr-grupo-san-luis",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Catalogo digital QR para stand de exposicion - Grupo San Luis (Lubricantes y Repuestos)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:ssr": "vite build --config vite.ssr-check.config.ts && node dist-ssr/ssr-check.js",
    "api:local": "tsx scripts/prueba-api.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "write-excel-file": "^4.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
